# ---- Server ----
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# ---- Database / cache ----
DATABASE_URL=postgresql://lumi:lumi@localhost:5432/lumi?schema=public
REDIS_URL=redis://localhost:6379/0

# ---- JWT (change in production! >= 32 random chars) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CODE_HMAC_SECRET=change-me-code-secret

# ---- Email (leave SMTP_HOST empty in dev: codes are printed to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lumi <no-reply@lumi.local>"
# Dev/test only: include the 6-digit code in API responses (refused when NODE_ENV=production)
DEV_EXPOSE_CODES=true

# ---- Matching ----
SOUL_MATCH_SECONDS=180
VOICE_MATCH_SECONDS=420

# ---- Voice Match (LiveKit). Empty = voice match disabled ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Push (FCM) stub: set to enable real sending later ----
FCM_SERVICE_ACCOUNT_JSON=
